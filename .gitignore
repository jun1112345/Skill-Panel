# 该 .gitignore 文件应放置在 Unity 项目根目录下
#
# 获取最新版本：https://github.com/github/gitignore/blob/main/Unity.gitignore
#
# 建议：根据需要添加来自 Global/ 模板的编辑器/操作系统/工具特定忽略规则。
# 参见：https://github.com/github/gitignore/tree/main/Global
#
.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
*.log

# 默认情况下 Unity 支持 Blender 资源导入，*.blend1 文件无需提交到版本控制。
*.blend1
*.blend1.meta

# MemoryCaptures 可能会过大。
# 它们也可能包含极其敏感的数据。
/[Mm]emoryCaptures/

# 录制文件可能会过大。
/[Rr]ecordings/

# 如果你希望忽略 Asset Store Tools 插件，请取消下一行的注释。
# /[Aa]ssets/AssetStoreTools*

# 自动生成的 Jetbrains Rider 插件
/[Aa]ssets/Plugins/Editor/JetBrains*
# Jetbrains Rider 个人层设置
*.DotSettings.user

# Visual Studio 缓存目录
.vs/

# Gradle 缓存目录
.gradle/

# 自动生成的 VS/MD/Consulo 解决方案和项目文件
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D 生成的元文件
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D 崩溃报告时生成的文件
sysinfo.txt

# Mono 自动生成的文件
mono_crash.*

# 构建产物
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics 生成的文件
crashlytics-build.properties

# TestRunner 生成的文件
InitTestScene*.unity*

# Addressables 默认忽略项，在用户自定义之前
/ServerData
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
# 默认情况下，Addressables 内容构建会在平台特定的子文件夹中生成
# addressables_content_state.bin 文件，例如：
# /Assets/AddressableAssetsData/OSX/addressables_content_state.bin
/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting 自动生成的文件
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# 游玩模式测试自动生成的场景
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# UI Toolkit 自动生成的文件
/UIElementsSchema/

# Assets 文件夹内自动生成的缓存
/[Aa]ssets/[Ss]ceneDependencyCache*